{
    "name": "@telegenie/teleproto",
    "version": "1.228.5",
    "private": true,
    "description": "Modern Telegram MTProto client for Node.js, written in TypeScript",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./sessions": {
            "types": "./dist/sessions/index.d.ts",
            "default": "./dist/sessions/index.js"
        },
        "./events": {
            "types": "./dist/events/index.d.ts",
            "default": "./dist/events/index.js"
        },
        "./Utils": {
            "types": "./dist/Utils.d.ts",
            "default": "./dist/Utils.js"
        },
        "./client/telegramBaseClient": {
            "types": "./dist/client/telegramBaseClient.d.ts",
            "default": "./dist/client/telegramBaseClient.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        },
        "./*/*": {
            "types": "./dist/*/*.d.ts",
            "default": "./dist/*/*.js"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sanyok12345/teleproto.git"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsc -p tsconfig.json && cp teleproto/tl/generated/api.js dist/tl/generated/api.js && cp teleproto/tl/generated/api.d.ts dist/tl/generated/api.d.ts",
        "typecheck": "tsc --noEmit",
        "generate:tl": "ts-node --transpile-only teleproto_generator/generate.ts",
        "generate:errors": "ts-node --transpile-only teleproto_generator/generate-errors.ts",
        "generate:docs": "ts-node --transpile-only teleproto_generator/harvest-docs.ts",
        "generate": "npm run generate:tl && npm run generate:errors",
        "publish:dist-manifest": "node -e \"const fs=require('fs');const pkg=require('./package.json');const out={name:pkg.name,version:pkg.version,description:pkg.description,main:pkg.main,types:pkg.types,repository:pkg.repository,license:pkg.license,bugs:pkg.bugs,keywords:pkg.keywords,homepage:pkg.homepage,funding:pkg.funding,engines:pkg.engines,dependencies:pkg.dependencies};fs.writeFileSync('dist/package.json',JSON.stringify(out,null,2)+'\\n');\"",
        "publish:prepare": "npm run clean && npm run generate:tl && npm run generate:errors && npm run build && npm run typecheck && npm run publish:dist-manifest && cp README.md LICENSE dist/ && cp teleproto/define.d.ts dist/define.d.ts && cp teleproto/tl/generated/api.js dist/tl/generated/api.js && cp teleproto/tl/generated/api.d.ts dist/tl/generated/api.d.ts && rm -f dist/tsconfig.tsbuildinfo",
        "publish:check": "npm run publish:prepare && npm pack ./dist --dry-run",
        "publish:latest": "npm run publish:prepare && npm publish ./dist --tag latest",
        "publishOnly": "npm run publish:latest",
        "docs": "typedoc"
    },
    "license": "MIT",
    "engines": {
        "node": ">=18"
    },
    "bugs": {
        "url": "https://github.com/sanyok12345/teleproto/issues"
    },
    "keywords": [
        "telegram",
        "telegram-client",
        "telegram-api",
        "mtproto",
        "userbot",
        "typescript",
        "nodejs",
        "gramjs",
        "gramjs-alternative",
        "api",
        "client",
        "bot",
        "library"
    ],
    "homepage": "https://docs.teleproto.dev",
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/sanyok12345"
    },
    "devDependencies": {
        "@types/mime": "^2.0.3",
        "@types/node": "^22.15.18",
        "ts-node": "^9.1.1",
        "typedoc": "^0.28.7",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "big-integer": "^1.6.48",
        "buffer": "^6.0.3",
        "mime": "^3.0.0",
        "store2": "^2.13.0"
    },
    "browser": {
        "buffer": "buffer"
    }
}
