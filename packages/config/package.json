{
  "name": "@telegenie/config",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "default": "./dist/constants/index.js"
    },
    "./env": {
      "types": "./dist/env/index.d.ts",
      "default": "./dist/env/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc6 -p tsconfig.build.json --noCheck",
    "dev": "tsc6 -p tsconfig.build.json --noCheck --watch --preserveWatchOutput",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.1",
    "@types/node": "^22.13.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
