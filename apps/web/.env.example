# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_API_TIMEOUT=10000

# Telegram Configuration
NEXT_PUBLIC_TELEGRAM_API_ID=xxxx
NEXT_PUBLIC_TELEGRAM_API_HASH=xxxx

# AI Models (takes precedence over browser localStorage)
# Google Gemini (for gemini-3.8)
NEXT_PUBLIC_GEMINI_API_KEY=
# Anthropic Claude (for claude-sonnet-5-5, claude-haiku-5-5)
NEXT_PUBLIC_ANTHROPIC_API_KEY=
# OpenAI (for gpt-4o, gpt-4o-mini)
NEXT_PUBLIC_OPENAI_API_KEY=

# App Configuration
NEXT_PUBLIC_APP_NAME=TeleGenie
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENVIRONMENT=development

# Feature Flags
NEXT_PUBLIC_ENABLE_DEBUG=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# External Services
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id_here
